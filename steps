--------------
DATABASE
--------------

CREATE TABLE players (
    player_id INTEGER,
    name TEXT NOT NULL,
    PRIMARY KEY (player_id)
);


CREATE TABLE ratings (
    rating_id INTEGER,
    date TEXT,
    player_id INTEGER,
    rating_system TEXT,
    rating INTEGER,
    PRIMARY KEY (rating_id),
    FOREIGN KEY (player_id) REFERENCES players(player_id)
);

CREATE TABLE games (
    game_id INTEGER,
    opening TEXT,
    player_id INTEGER,
    side TEXT,
    date TEXT,
    PRIMARY KEY (game_id),
    FOREIGN KEY (player_id) REFERENCES players(player_id)
);


CREATE TABLE tags (
    tag_id INTEGER,
    tag TEXT,
    PRIMARY KEY (tag_id)
);

CREATE TABLE moves (
    move_id INTEGER,
    move_number INTEGER,
    fen_before TEXT,
    played_move TEXT,
    cp_loss REAL,
    tag_id INTEGER,
    comment TEXT,
    game_id INTEGER,
    PRIMARY KEY (move_id),
    FOREIGN KEY (game_id) REFERENCES games(game_id)
);

CREATE TABLE moves_tags (
	move_id INTEGER,
	tag_id INTEGER,
	FOREIGN KEY (move_id) REFERENCES moves(move_id),
	FOREIGN KEY (tag_id) REFERENCES tags(tag_id)
);