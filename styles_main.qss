QWidget {
    background: hsl(0, 0, 50);
    font-family: Helvetica Neue;
    font-size: 14px;
    color: hsl(0, 0, 200);
}

QPushButton[level="1"],
QPushButton[level="2"],
QPushButton[level="3"] {
    border-radius: 10px;
    font-size: 20px;
    padding: 10px;
}

QPushButton[level="1"]:pressed,
QPushButton[level="2"]:pressed,
QPushButton[level="3"]:pressed {
    border-color: hsl(0, 0, 150);
    border-style: solid;
    border-width: 2px;
}

QPushButton[level="1"] {
    background-color: hsl(220, 120, 130);

}

QPushButton[level="2"] {
    background-color: hsl(0, 0, 80);
}

QPushButton[level="3"] {
    background-color: hsl(0, 0, 50);
    border-color: hsl(0, 0, 80);
    border-style: solid;
    border-width: 3px;
}